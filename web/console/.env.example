# maintainerd-secret console — build-time / dev environment.
#
# Every value here is ALSO readable at RUN time from window.__ENV__
# (public/config.js), so one built image can target several deployments without
# a rebuild. None of these is a secret: the console is a PUBLIC OAuth client
# (authorization code + PKCE, no client secret).
#
# TWO SPELLINGS, ONE MEANING. At runtime the console prefers the SERVICE's own
# variable names — SECRET_CONSOLE_CLIENT_ID, AUTH_ISSUER, AUTH_AUDIENCE — so an
# operator setting up a standalone deployment sets each value ONCE and both the
# service and its console read it. The VITE_ names below are the build-time
# spellings and remain fully supported; they are what a local .env uses.
#
#   runtime (window.__ENV__)        build time (.env, this file)
#   -----------------------------   ----------------------------------
#   SECRET_API_BASE_URL             VITE_SECRET_API_BASE_URL
#   AUTH_ISSUER                     VITE_OAUTH_ISSUER_URL
#   SECRET_CONSOLE_TOKEN_URL        VITE_OAUTH_TOKEN_URL
#   SECRET_CONSOLE_CLIENT_ID        VITE_OAUTH_CLIENT_ID
#   AUTH_AUDIENCE                   VITE_OAUTH_AUDIENCE
#   SECRET_CONSOLE_SCOPE            VITE_OAUTH_SCOPE

# Where secret's REST API lives. Leave empty for the same-origin default
# (`/api/v1`), which is what the maintainerd-dev nginx edge serves.
VITE_SECRET_API_BASE_URL=

# --- identity ---------------------------------------------------------------
# ISSUER_URL, TOKEN_URL and CLIENT_ID are required TOGETHER. Set none of them and
# the console runs in guard-open mode: it calls the API with no bearer token,
# which only works while maintainerd-secret runs with APP_ENV=development and no
# AUTH_JWKS_URL/AUTH_ISSUER/AUTH_AUDIENCE. The shell shows a permanent banner in
# that mode. A half-configured identity is treated as none, because it would
# otherwise send an operator to an authorize endpoint whose code can never be
# exchanged.

# The maintainerd-auth hosted identity app, e.g. https://identity.auth.maintainerd.local
# Runtime name: AUTH_ISSUER — the same origin the service enforces as its issuer.
VITE_OAUTH_ISSUER_URL=

# Absolute URL of the OAuth token endpoint on maintainerd-auth's public API,
# e.g. https://identity-api.auth.maintainerd.local/api/v1/oauth/token
# Runtime name: SECRET_CONSOLE_TOKEN_URL.
VITE_OAUTH_TOKEN_URL=

# The console's OAuth client id in maintainerd-auth — the FRONTEND SPA CLIENT an
# operator creates by hand during standalone setup. Public clients only.
# Runtime name: SECRET_CONSOLE_CLIENT_ID, which is also what the service
# validates at boot in standalone mode.
VITE_OAUTH_CLIENT_ID=

# The resource-API audience secret enforces (AUTH_AUDIENCE on the service). The
# token has to be minted FOR secret, or its verifier rejects it.
# Runtime name: AUTH_AUDIENCE.
VITE_OAUTH_AUDIENCE=

# Extra scopes beyond `openid profile email`. The secret permissions a user holds
# come from their Auth grants, not from what the console asks for.
# Runtime name: SECRET_CONSOLE_SCOPE.
VITE_OAUTH_SCOPE=
